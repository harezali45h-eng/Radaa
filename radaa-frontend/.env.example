# Root env example for Radaa (non-sensitive placeholders)
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/radaa_example
MONGODB_URI=mongodb://127.0.0.1:27017/radaa_example
JWT_SECRET=changeme_jwt_secret
JWT_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000

# Backend feature flag fallbacks (all default OFF)
FEATURE_FALLBACK_ROUTES_V1=false
FEATURE_FALLBACK_DRIVER_REQUESTS_V1=false
FEATURE_FALLBACK_AUTO_CANCEL_V1=false
FEATURE_FALLBACK_DRIVER_SIGNUP_V1=false
FEATURE_FALLBACK_SACCO_ADMIN_V1=false
FEATURE_FALLBACK_MATATU_PHOTOS_V1=false
FEATURE_FALLBACK_GLOBAL_MAP_V1=false
FEATURE_FALLBACK_RATINGS_V1=false
FEATURE_FALLBACK_UI_REVAMP_V1=false
FEATURE_FALLBACK_MAP_PHOTOS_V1=false
FEATURE_FALLBACK_TRIP_UI_V1=false
FEATURE_FALLBACK_DRIVER_ONBOARD_V1=false
FEATURE_FALLBACK_SACCO_ONBOARD_V1=false

# Image CDN (optional, for production/staging)
IMAGE_CDN_BASE=https://your-image-cdn.example.com
IMAGE_CDN_KEY=your-image-cdn-key
IMAGE_CDN_SECRET=your-image-cdn-secret

# FCM (optional, for push notifications)
FCM_SERVER_KEY=your-fcm-server-key

# Frontend URL to backend (for Next.js)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Frontend env example (Next.js)
NEXT_PUBLIC_API_BASE_URL=https://radaa-1.onrender.com/api
NEXT_PUBLIC_API_URL=https://radaa-1.onrender.com/api
NEXT_PUBLIC_SOCKET_URL=wss://radaa-1.onrender.com
NEXT_PUBLIC_APP_ENV=development

# Optional: image CDN base for client-side URL construction
NEXT_PUBLIC_IMAGE_CDN_BASE=https://your-image-cdn.example.com

# Google Maps JavaScript API key (client-side)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
