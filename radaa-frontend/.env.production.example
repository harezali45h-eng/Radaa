# Production env for Next.js on Vercel (no secrets)
# Set the same values in the Vercel project settings.

# Public URL of your deployed backend (origin only)
NEXT_PUBLIC_API_BASE_URL=https://radaa-1.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://radaa-1.onrender.com

# Base URL for HTTP API calls (points at Express /api root)
NEXT_PUBLIC_API_URL=https://radaa-1.onrender.com/api

# Socket URL for realtime updates
NEXT_PUBLIC_SOCKET_URL=wss://radaa-1.onrender.com

# Environment markers (Vercel will also set NODE_ENV=production)
NEXT_PUBLIC_ENV=production
NODE_ENV=production

# Optional: image CDN base for client-side URL construction
# NEXT_PUBLIC_IMAGE_CDN_BASE=https://your-image-cdn.example.com
