# Production env for Next.js on Vercel (no secrets)
# Set the same values in the Vercel project settings.

# Public URL of your deployed backend (used by HTTP APIs and sockets)
NEXT_PUBLIC_BACKEND_URL=https://your-backend-project.vercel.app

# Optional: image CDN base for client-side URL construction
# NEXT_PUBLIC_IMAGE_CDN_BASE=https://your-image-cdn.example.com
