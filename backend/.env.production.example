# Production env for backend on Vercel (no secrets)
# Set the same values in the Vercel backend project settings.

# Vercel provides PORT automatically; do NOT hardcode it.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# JWT configuration
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# CORS: set to your deployed frontend URL(s); comma-separated list
CORS_ORIGIN=https://your-frontend-project.vercel.app,https://your-custom-domain.com,*.vercel.app,http://localhost:3000

# Mpesa Daraja API (set in production environment variables; do not commit real keys)
# MPESA_CONSUMER_KEY=your-mpesa-consumer-key
# MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
# MPESA_PASSKEY=your-mpesa-passkey
# MPESA_SHORTCODE=600000
# MPESA_CALLBACK_URL=https://your-backend-host/api/mpesa/callback
# MPESA_ENV=production

# Optional feature flags & other backend-only settings can be copied from .env.example
