{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "release": {
      "distribution": "store",
      "env": {
        "EXPO_NO_METRO_WORKSPACE_ROOT": "1"
      },
      "android": {
        "gradleCommand": ":app:bundleRelease",
        "image": "ubuntu-22.04-jdk-17-ndk-r25b"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
